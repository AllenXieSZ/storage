#!/usr/bin/env bash
# storage 仓库 pre-commit 泄露检查钩子
# 安装: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 或:  git config core.hooksPath scripts  (让 scripts/ 下的 pre-commit 生效)
# 绕过(确认无泄露时): git commit --no-verify

set -u
RED=$'\033[31m'; YEL=$'\033[33m'; NC=$'\033[0m'
fail=0

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

report(){ echo "${RED}[泄露拦截]${NC} $1"; fail=1; }

for f in $staged; do
  [ -f "$f" ] || continue
  added=$(git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++')
  [ -z "$added" ] && continue

  # 1. AWS Access Key ID
  echo "$added" | grep -qE 'AKIA[0-9A-Z]{16}' && report "$f: 疑似 AWS Access Key ID (AKIA...)"
  # 2. AWS Secret Access Key 真实值(40位)
  echo "$added" | grep -qE '(aws_secret_access_key|SecretAccessKey)["'"'"' :=]+[A-Za-z0-9/+]{40}' && report "$f: 疑似 AWS Secret Access Key"
  # 3. 阿里云 AccessKey
  echo "$added" | grep -qE 'LTAI[0-9A-Za-z]{12,20}' && report "$f: 疑似阿里云 AccessKey (LTAI...)"
  # 4. AWS 账号 ID
  echo "$added" | grep -qE 'arn:aws[a-z-]*:[a-z0-9-]*:[a-z0-9-]*:[0-9]{12}:' && report "$f: ARN 中含 AWS 账号 ID"
  echo "$added" | grep -qiE '(account[_-]?id|owner[_-]?id)["'"'"' :=]+[0-9]{12}' && report "$f: 疑似 AWS 账号 ID 字段"
  # 5. 明文密码
  echo "$added" | grep -E '#2026|FsxOntap#|OpenCart#2026|AuroraBk#|Admin#2026' | grep -qv REDACTED && report "$f: 疑似真实测试密码字符串"
  # 6. 私钥
  echo "$added" | grep -qE 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY' && report "$f: 含私钥 PEM"
  # 7. token
  echo "$added" | grep -qE 'gh[pousr]_[0-9A-Za-z]{36}' && report "$f: 疑似 GitHub token"
  echo "$added" | grep -qE 'xox[baprs]-[0-9A-Za-z-]{10,}' && report "$f: 疑似 Slack token"
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "${YEL}提交被拦截: 检测到疑似敏感信息。请替换为占位符(REDACTED / <PASSWORD>)后再提交。${NC}"
  echo "${YEL}确认误报可用: git commit --no-verify${NC}"
  exit 1
fi
exit 0

{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "FSx", "Effect": "Allow", "Action": ["fsx:DescribeFileSystems"], "Resource": "*"},
    {"Sid": "STS", "Effect": "Allow", "Action": "sts:GetCallerIdentity", "Resource": "*"},
    {"Sid": "S3Csv", "Effect": "Allow", "Action": "s3:PutObject", "Resource": "arn:aws:s3:::BUCKET/fsx-mw/*"},
    {"Sid": "Lambda", "Effect": "Allow",
     "Action": ["lambda:CreateFunction", "lambda:GetFunction", "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration", "lambda:GetFunctionConfiguration",
                "lambda:PutFunctionConcurrency", "lambda:PutFunctionEventInvokeConfig", "lambda:InvokeFunction"],
     "Resource": "arn:aws:lambda:*:ACCOUNT_ID:function:fsx-mw-scheduler"},
    {"Sid": "Scheduler", "Effect": "Allow",
     "Action": ["scheduler:CreateScheduleGroup", "scheduler:CreateSchedule", "scheduler:UpdateSchedule",
                "scheduler:DeleteSchedule", "scheduler:GetSchedule", "scheduler:ListSchedules"],
     "Resource": ["arn:aws:scheduler:*:ACCOUNT_ID:schedule-group/fsx-mw",
                  "arn:aws:scheduler:*:ACCOUNT_ID:schedule/fsx-mw/*"]},
    {"Sid": "SnsSqsCw", "Effect": "Allow",
     "Action": ["sns:CreateTopic", "sns:Subscribe", "sqs:CreateQueue", "sqs:GetQueueAttributes",
                "cloudwatch:PutMetricAlarm"],
     "Resource": ["arn:aws:sns:*:ACCOUNT_ID:fsx-mw-alerts", "arn:aws:sqs:*:ACCOUNT_ID:fsx-mw-dlq",
                  "arn:aws:cloudwatch:*:ACCOUNT_ID:alarm:fsx-mw-*"]},
    {"Sid": "IAM", "Effect": "Allow",
     "Action": ["iam:CreateRole", "iam:GetRole", "iam:PutRolePolicy", "iam:PassRole"],
     "Resource": ["arn:aws:iam::ACCOUNT_ID:role/fsx-mw-scheduler-lambda-role",
                  "arn:aws:iam::ACCOUNT_ID:role/fsx-mw-scheduler-invoke-role"]}
  ]
}

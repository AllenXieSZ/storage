{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FSxReadUpdate",
      "Effect": "Allow",
      "Action": [
        "fsx:DescribeFileSystems",
        "fsx:UpdateFileSystem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaManage",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:InvokeFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:*:ACCOUNT_ID:function:fsx-mw-*"
    },
    {
      "Sid": "EventBridgeRulesManage",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:PutTargets",
        "events:DeleteRule",
        "events:RemoveTargets",
        "events:DescribeRule"
      ],
      "Resource": "arn:aws:events:*:ACCOUNT_ID:rule/fsx-mw-*"
    },
    {
      "Sid": "EventBridgeSchedulerManage",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule",
        "scheduler:GetSchedule"
      ],
      "Resource": "arn:aws:scheduler:*:ACCOUNT_ID:schedule/default/fsx-mw-*"
    },
    {
      "Sid": "IAMPassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/fsx-mw-lambda-role",
        "arn:aws:iam::ACCOUNT_ID:role/fsx-mw-scheduler-role"
      ]
    },
    {
      "Sid": "IAMForRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/fsx-mw-lambda-role",
        "arn:aws:iam::ACCOUNT_ID:role/fsx-mw-scheduler-role"
      ]
    },
    {
      "Sid": "STSGetCallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
